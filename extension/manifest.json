{
  "manifest_version": 3,
  "name": "Browser Usage Tracker",
  "version": "0.2.0",
  "description": "Private, local-only browser activity totals. No history, no full URLs, no server.",
  "key": "",
  "permissions": ["storage", "alarms", "idle", "tabs"],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Browser Usage Tracker"
  },
  "options_page": "options/options.html",
  "externally_connectable": {
    "matches": [
      "https://kuyapol.github.io/*",
      "http://localhost/*",
      "http://127.0.0.1/*"
    ]
  }
}
